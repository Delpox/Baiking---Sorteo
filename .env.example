# ------------------------------------------------------------
# Baiking · Curso + Participación — variables de entorno
# Copiar a .env (local) o cargar en Vercel > Settings > Environment Variables
# ------------------------------------------------------------

# URL pública del sitio (sin barra final). Se usa para back_urls y notification_url de Mercado Pago.
BASE_URL=https://participa.baiking.com.ar

# --- Mercado Pago (Checkout Pro) ---
# Credenciales de producción: https://www.mercadopago.com.ar/developers/panel/app
MP_ACCESS_TOKEN=APP_USR-xxxxxxxxxxxxxxxx
# Clave secreta del webhook (Panel > Tu aplicación > Webhooks > Configurar > Clave secreta)
MP_WEBHOOK_SECRET=xxxxxxxxxxxxxxxx

# --- Supabase (base de datos) ---
SUPABASE_URL=https://xxxxxxxx.supabase.co
# Usar SIEMPRE la service_role key en el backend (nunca exponerla en el frontend)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# --- Email transaccional (Resend) ---
RESEND_API_KEY=re_xxxxxxxx
MAIL_FROM="Baiking <hola@baiking.com.ar>"

# --- WhatsApp Cloud API (Meta) — opcional ---
# Si no se configura, el sistema solo manda mail y deja el WhatsApp como link manual.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
# Nombre de la plantilla aprobada en Meta Business (ver docs/04-automatizaciones.md)
WHATSAPP_TEMPLATE_NAME=participacion_confirmada
WHATSAPP_TEMPLATE_LANG=es_AR

# --- Administración ---
# Token para exportar el padrón de participaciones (CSV) desde /api/export?token=...
ADMIN_TOKEN=cambiar-por-un-token-largo-y-aleatorio
