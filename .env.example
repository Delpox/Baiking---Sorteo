# ------------------------------------------------------------
# Baiking · Curso + Participación — variables de entorno
# Copiar a .env (local) o cargar en Vercel > Settings > Environment Variables
# OJO: Vercel guarda los valores tal cual, SIN quitar comillas: no usar comillas en ningún valor.
# ------------------------------------------------------------

# URL pública del sitio (sin barra final). OBLIGATORIA en producción: con ella se arman
# los links que viajan por mail (/gracias, subir el comprobante) y las back_urls y
# notification_url de Mercado Pago. Si falta, el backend usa el dominio de producción
# que inyecta Vercel y, en último caso, el host de la request (con una advertencia en los logs).
BASE_URL=https://participa.baiking.com.ar

# --- Mercado Pago (Checkout Pro) ---
# Credenciales de producción: https://www.mercadopago.com.ar/developers/panel/app
MP_ACCESS_TOKEN=APP_USR-xxxxxxxxxxxxxxxx
# Clave secreta del webhook (Panel > Tu aplicación > Webhooks > Configurar > Clave secreta).
# OBLIGATORIA en producción: si falta, el webhook responde 401 y no procesa ningún pago.
MP_WEBHOOK_SECRET=xxxxxxxxxxxxxxxx

# --- Supabase (base de datos) ---
SUPABASE_URL=https://xxxxxxxx.supabase.co
# Usar SIEMPRE la service_role key en el backend (nunca exponerla en el frontend)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# --- Email transaccional (Resend) ---
RESEND_API_KEY=re_xxxxxxxx
# Remitente. Sin comillas (Vercel no las quita y Resend rechazaría el valor con un 422).
MAIL_FROM=Baiking <hola@baiking.com.ar>

# --- WhatsApp Cloud API (Meta) — opcional ---
# Si no se configura, el sistema solo manda mail y deja el WhatsApp como link manual.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
# Nombre de la plantilla aprobada en Meta Business (ver docs/03-automatizaciones.md)
WHATSAPP_TEMPLATE_NAME=participacion_confirmada
WHATSAPP_TEMPLATE_LANG=es_AR

# --- Administración ---
# Token del panel (admin.html) y de la exportación del padrón (/api/export).
# Viaja en el header Authorization: Bearer <token>; ?token= sigue aceptado solo como fallback.
ADMIN_TOKEN=cambiar-por-un-token-largo-y-aleatorio

# --- Transferencias con comprobante leído por IA (opcional) ---
# Clave de la API de Claude (https://platform.claude.com). Sin esta clave, los
# comprobantes se guardan igual y quedan "por revisar" en el panel, sin lectura automática.
ANTHROPIC_API_KEY=
# true = si la IA valida monto, cuenta destino, fecha y no ve señales de edición, la orden
# se aprueba sola (tanto con el comprobante adjunto en la inscripción como subido en /gracias).
# Recomendado: false hasta conciliar contra el extracto del banco (comprobantes falsos).
TRANSFERENCIAS_AUTO_APROBAR=false
# Secreto compartido con el servicio que recibe los mails (Cloudflare Email Worker,
# Resend/Postmark inbound) y llama a /api/inbound-email con el header X-Inbound-Secret.
INBOUND_SECRET=

# --- Anti-bots (PENDIENTE de decisión) ---
# Hoy los POST públicos tienen honeypot (vía gratuita), tope de registros por email
# (5 sin cargo por edición; 3 reservas por transferencia sin pagar en 24 h) y el índice
# único por DNI. No hay límite por IP (no se guarda la IP en ninguna tabla) ni captcha.
# Si aparece abuso, lo recomendado es Cloudflare Turnstile (gratis) en los dos
# formularios + verificación del token en el backend, o el WAF/rate limit de Vercel.

# --- Google Sheets (espejo de órdenes; ver docs/06-google-sheets.md) ---
# Service account con acceso de Editor a la planilla. Si faltan, api/sheets-sync responde
# { ok: false, motivo: 'sheets no configurado' } y el sitio funciona igual.
GOOGLE_SERVICE_ACCOUNT_EMAIL=baiking-sheets@<proyecto>.iam.gserviceaccount.com
# El private_key del JSON tal cual (con los \n escapados, como lo pega Vercel)
GOOGLE_PRIVATE_KEY=
# Id (o URL) de la planilla y pestaña (default "Órdenes")
GOOGLE_SHEETS_ID=
GOOGLE_SHEETS_TAB=Órdenes
# Vercel Cron manda "Authorization: Bearer <CRON_SECRET>" al llamar /api/sheets-sync y
# /api/recordatorios (mails "falta una semana" y "hoy es el sorteo", a las 10:00 de Buenos Aires).
# Los dos crons de vercel.json son diarios y son los únicos dos: el plan Hobby no permite más
# frecuencia ni más de 2 crons. docs/06 §5 explica el Apps Script para que marcar "Llegó la
# plata" en la planilla se aplique al instante.
CRON_SECRET=
